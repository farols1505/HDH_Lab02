@@ -9,6 +9,15 @@ r_mhartid()
   return x;
 }
 
+// return the value of the fp register.
+static inline uint64
+r_fp()
+{
+  uint64 x;
+  asm volatile("mv %0, s0" : "=r" (x));
+  return x;
+}
+
